[Unit]
Description=Trading AI single-account Alpaca paper executor
Documentation=file:///usr/share/doc/trading-ai-paper/executor-deployment.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=trading-ai-paper-executor
Group=trading-ai-paper-ipc
DynamicUser=no
WorkingDirectory=/

RuntimeDirectory=trading-ai-paper
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
StateDirectory=trading-ai-paper
StateDirectoryMode=0700

LoadCredentialEncrypted=alpaca-paper-api-key
LoadCredentialEncrypted=alpaca-paper-secret-key
UnsetEnvironment=ALPACA_PAPER_API_KEY ALPACA_PAPER_SECRET_KEY ALPACA_API_KEY ALPACA_SECRET_KEY ALPACA_LIVE_API_KEY ALPACA_LIVE_SECRET_KEY ALPACA_PAPER_TRADE ALPACA_MCP_ENV_FILE ANTHROPIC_AUTH_TOKEN MINIMAX_API_KEY OPENAI_API_KEY
Environment=PYTHONUNBUFFERED=1

ExecStart=/usr/bin/python3 -I -m trading_ai.execution.paper_executor_daemon --risk-config /etc/trading-ai-paper/risk.yml --authz-config /etc/trading-ai-paper/executor-authz.yml --universe-config /etc/trading-ai-paper/universe.yml --universe-config /etc/trading-ai-paper/crypto-alpaca.yml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
PrivateUsers=no
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
